#!/bin/zsh
#
# This file is loaded every time an interactive zsh shell is launched.
# The exports, aliases and functions are shared with bash.
#

test -f ~/.bash_exports && source ~/.bash_exports
test -f ~/.bash_aliases && source ~/.bash_aliases
test -f ~/.bash_functions && source ~/.bash_functions
test -f ~/.bash_temp_exports && source ~/.bash_temp_exports
test -f ~/.bash_temp_aliases && source ~/.bash_temp_aliases
test -f ~/.bash_temp_functions && source ~/.bash_temp_functions

test -d /opt/homebrew/bin && eval "$(/opt/homebrew/bin/brew shellenv)"
test -d /home/linuxbrew/.linuxbrew/bin && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

test -d "$DOTFILES_ROOT/bin" && export PATH="$DOTFILES_ROOT/bin:$PATH"
test -d ~/.local/bin && export PATH="$HOME/.local/bin:$PATH"
test -d ~/go/bin && export PATH="$HOME/go/bin:$PATH"
test -d ~/.tfenv/bin && export PATH="$HOME/.tfenv/bin:$PATH"
test -d ~/.proto && export PROTO_HOME=~/.proto && export PATH="$PROTO_HOME/shims:$PROTO_HOME/bin:$PATH"

test -f ~/miniconda3/etc/profile.d/conda.sh && source ~/miniconda3/etc/profile.d/conda.sh

if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi
