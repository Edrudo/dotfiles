#!/bin/bash
#
# Installs the pre-commit hook in every BioStrand repo under the given directory
# which has a .pre-commit-config.yaml and no hook yet.
#
# USAGE:
#
#   $ precommit-install-repos ~/Biostrand

set -e

if [ "$#" -ne 1 ] || [ ! -d "$1" ]; then
  echo "Usage: $0 <directory_containing_repos>" >&2
  exit 1
fi

if ! command -v pre-commit >/dev/null 2>&1; then
  echo "pre-commit is not installed" >&2
  exit 1
fi

for repo in "$(cd "$1" && pwd -P)"/*; do
  [ -d "$repo/.git" ] && [ -f "$repo/.pre-commit-config.yaml" ] && [ ! -f "$repo/.git/hooks/pre-commit" ] || continue

  origin_url=$(git -C "$repo" remote get-url origin 2>/dev/null || true)
  [[ "$origin_url" =~ github\.com[/:]BioStrand ]] || continue

  echo "Installing pre-commit hook in: $repo"
  (cd "$repo" && pre-commit install)
done
